class Solution {
public:
    int myAtoi(string s) {
        int i=0;
        long long sum=0;
        int sign=1;
        while(s[i]==' '){
            i++;
        }
        if(s[i]=='+' || s[i]=='-'){
            if(s[i]=='+'){
                sign=1;
            }
            else{
                sign=-1;
            }
        i++;
        }
        while(s[i]>='0' && s[i]<='9'){
            sum=sum*10+s[i]-'0';
            if(sign*sum>=INT_MAX)
            return INT_MAX;
            if(sign*sum<=INT_MIN)
            return INT_MIN;
            i++;
        }
        return (int)sign*sum;
    }
};
