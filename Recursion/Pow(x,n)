class Solution {
public:

    double calpow(double x,long long n){
        if(n==0){
            return 1;
        }
        else if(n<0){
            return calpow(1/x,-n);

        }
        else if(n%2==0){
            return calpow(x*x,n/2);
        }
        else{
            return x*calpow(x*x,(n-1)/2);
        }
    }
    double myPow(double x, int n) {
        double ans=calpow(x,n);
        return ans;
    }
};
