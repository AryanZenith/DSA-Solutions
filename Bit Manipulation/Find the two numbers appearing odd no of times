class Solution {
  public:
    vector<int> twoOddNum(vector<int>& arr) {
        // code here
        unordered_map<int,int>mp;
        vector<int>ans;
        for(int i=0;i<arr.size();i++){
            mp[arr[i]]++;
        }
        for(auto it:mp){
            if(it.second%2!=0){
                ans.push_back(it.first);
            }
        }
        sort(ans.begin(),ans.end(), greater<>());
        return ans;
    }
};
