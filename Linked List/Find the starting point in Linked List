class Solution {
public:
    ListNode *detectCycle(ListNode *head) {
        ListNode* slow=head;
        ListNode* fast=head;
        ListNode* p=head;
        while(fast!=NULL && fast->next!=NULL){
            slow=slow->next;
            fast=fast->next->next;

            if(slow==fast){
                while(slow!=p){
                    p=p->next;
                    slow=slow->next;
                }
            return p;
            }
        }
        return NULL;
    }
};
