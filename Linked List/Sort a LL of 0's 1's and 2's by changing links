class Solution {
  public:
    Node* segregate(Node* head) {
        // code here
        int zero=0;
        int one=0;
        int two=0;
        Node* temp=head;
        while(temp!=NULL){
            if(temp->data==0){
                zero++;
            }
            else if(temp->data==1){
                one++;
            }
            else{
                two++;
            }
            temp=temp->next;
        }
        Node*temp2=head;
        while(zero>0){
            temp2->data=0;
            temp2=temp2->next;
            zero--;
        }
        while(one>0){
            temp2->data=1;
            temp2=temp2->next;
            one--;
        }
        while(two>0){
            temp2->data=2;
            temp2=temp2->next;
            two--;
        }
        return head;
    }
};
