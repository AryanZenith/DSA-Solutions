class Solution {
  public:
    Node* delPos(Node* head, int x) {
        // code here
        Node* temp=head;
        if(x==1){
            head=head->next;
        }
       Node*k;
       while(x>1){
           k=temp;
           temp=temp->next;
           x--;
       }
       if(temp->next!=NULL){
           k->next=temp->next;
           temp->next->prev=temp->prev;
       }
       else{
        k->next=NULL;
       }
        return head;
    }
};
