class Solution {
public:
    ListNode* deleteMiddle(ListNode* head) {

        ListNode* slow=head;
        ListNode* fast=head;
        ListNode* prev=NULL;
        if(head==NULL || head->next==NULL){
            return NULL;
        }
        while(fast!=NULL && fast->next!=NULL){
            fast=fast->next->next;
            prev=slow;
            slow=slow->next;
        }
        prev->next=slow->next;
        delete(slow);
        return head;
    }
};
