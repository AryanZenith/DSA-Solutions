class Solution {
  public:
    Node *insertAtPos(Node *head, int p, int x) {
        // code here
        Node* k= new Node(x);
        Node* temp=head;
        while(p>0){
            temp=temp->next;
            p--;
        }
        k->next=temp->next;
        if(temp->next!=NULL){
            temp->next->prev=k;
        }
        temp->next=k;
        k->prev=temp;
        
        return head;
    }
};
